{
  "name": "brightframe",
  "version": "0.4.3",
  "description": "React UI component kit with buttons, cards, tags, form controls, and date/time pickers — themeable via a light/dark/high-contrast design token system and a drop-in ThemeProvider.",
  "keywords": [
    "react",
    "react-components",
    "ui-kit",
    "ui-library",
    "component-library",
    "design-system",
    "design-tokens",
    "storybook",
    "typescript",
    "theme",
    "dark-mode",
    "accessibility",
    "a11y",
    "css-modules",
    "buttons",
    "cards",
    "forms",
    "form-validation",
    "react-hook-form",
    "formik",
    "date-picker",
    "time-picker"
  ],
  "homepage": "https://mkokoulin.github.io/brightframe/",
  "bugs": {
    "url": "https://github.com/mkokoulin/brightframe/issues"
  },
  "author": "mkokoulin",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/brightframe.cjs",
  "module": "./dist/brightframe.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/brightframe.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/brightframe.js",
      "require": "./dist/brightframe.cjs"
    },
    "./tokens.css": "./dist/tokens.css",
    "./fonts.css": "./dist/fonts.css",
    "./style.css": "./dist/brightframe.css",
    "./*.css": "./dist/*.css",
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "require": "./dist/*.cjs"
    }
  },
  "scripts": {
    "css-types": "tcm src --pattern \"**/*.module.css\"",
    "css-types:watch": "tcm src --pattern \"**/*.module.css\" --watch",
    "predev": "npm run css-types",
    "dev": "vite",
    "prebuild": "npm run css-types",
    "build": "vite build && node scripts/copy-tokens.mjs && node scripts/bundle-css.mjs",
    "pretypecheck": "npm run css-types",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "size": "size-limit",
    "test": "vitest run",
    "test:unit": "vitest run --project=unit",
    "test:storybook": "vitest run --project=storybook",
    "test:visual": "vitest run --project=visual",
    "test:visual:update": "vitest run --project=visual -u",
    "codemod:migrate-legacy-kit": "bun codemods/migrate-legacy-kit/cli.ts",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "formik": ">=2",
    "react-hook-form": ">=7"
  },
  "peerDependenciesMeta": {
    "formik": {
      "optional": true
    },
    "react-hook-form": {
      "optional": true
    }
  },
  "dependencies": {
    "react-imask": "^7.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@size-limit/preset-small-lib": "^13.0.3",
    "@storybook/addon-a11y": "^10.3.6",
    "@storybook/addon-docs": "10.3.6",
    "@storybook/addon-vitest": "10.3.6",
    "@storybook/react-vite": "10.3.6",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/browser": "4.1.10",
    "@vitest/browser-playwright": "4.1.10",
    "eslint": "^10.9.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "formik": "^2.4.9",
    "jest-axe": "^11.0.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.86.0",
    "size-limit": "^13.0.3",
    "storybook": "10.3.6",
    "ts-morph": "^28.0.0",
    "typed-css-modules": "^0.9.1",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mkokoulin/brightframe.git"
  },
  "funding": {
    "type": "buymeacoffee",
    "url": "https://buymeacoffee.com/kokoulin92u"
  }
}
