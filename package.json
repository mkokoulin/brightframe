{
  "name": "brightframe",
  "version": "0.1.0",
  "description": "Independent React UI kit extracted from the LAN coworking site — presentational primitives (Btn, Card, Tag, Title, ...) with light/dark/a11y design tokens.",
  "keywords": ["react", "ui-kit", "components", "design-system"],
  "author": "mkokoulin",
  "license": "MIT",
  "type": "module",
  "sideEffects": ["**/*.css"],
  "files": ["dist"],
  "main": "./dist/brightframe.cjs",
  "module": "./dist/brightframe.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/brightframe.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/brightframe.js",
      "require": "./dist/brightframe.cjs"
    },
    "./tokens.css": "./dist/tokens.css",
    "./style.css": "./dist/brightframe.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/copy-tokens.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@storybook/react-vite": "10.3.6",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^30.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "10.3.6",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mkokoulin/brightframe.git"
  }
}
